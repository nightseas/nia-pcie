#!/bin/sh
# ---------------------------------------------------------------------------
# File        : cocotb-config
# Description : Parse-only stand-in for cocotb-config used by `make check`, so a
#               simulation Makefile can be parsed for its source list with no
#               simulator present. It never runs a simulation.
# Author      : Xiaohai Li <haixiaolee@gmail.com>
#
#
# Copyright (c) 2026 Xiaohai Li <haixiaolee@gmail.com>
# SPDX-License-Identifier: BSD-2-Clause-Views
# ---------------------------------------------------------------------------
HERE=$(cd "$(dirname "$0")" && pwd)
case "$1" in
--makefiles|--share) echo "$HERE" ;;
--prefix) echo "$HERE" ;;
--python-bin) command -v python3 ;;
*) echo "" ;;
esac
